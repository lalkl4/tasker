# Скопируйте в .env и поправьте под себя: cp .env.example .env

# ---------- версия ----------
# Единственное место, где записано, что развёрнуто. Меняется через
# `make update VERSION=...`, откатывается через `make rollback`.
# Значения: номер релиза (1.4.2), либо main для последней сборки из ветки.
TASKER_VERSION=main

# ---------- домен ----------
# localhost — Caddy подпишет сертификат внутренним УЦ, браузер поругается.
# Настоящий домен — Caddy сам получит сертификат Let's Encrypt.
# Домен должен уже указывать на этот сервер, иначе выпуск не пройдёт.
TASKER_DOMAIN=localhost

# Порты наружу. Менять нужно, если 80 и 443 уже заняты.
TASKER_HTTP_PORT=80
TASKER_HTTPS_PORT=443

# ---------- база ----------
# Обязательно смените для сервера, смотрящего в интернет.
TASKER_DB_PASSWORD=смените-этот-пароль

# Сколько дампов хранить, старые удаляются автоматически
TASKER_KEEP_BACKUPS=14

# ---------- приложение ----------
# Пустой секрет сервер сгенерирует сам и сохранит в томе. Задавайте явно,
# только если поднимаете несколько реплик за балансировщиком.
# Минимум 32 байта: python -c "import secrets; print(secrets.token_urlsafe(48))"
TASKER_JWT_SECRET=

# Веб и API живут под одним доменом, поэтому браузеру CORS не нужен.
# Звёздочка оставлена ради мобильного клиента — он ходит с другого источника.
TASKER_CORS_ORIGINS=*

# false закрывает регистрацию: полезно, когда все свои уже завелись
TASKER_ALLOW_REGISTRATION=true
