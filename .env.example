# Скопируйте в .env и поправьте под себя.

# Пароль к PostgreSQL. Обязательно смените для инстанса, смотрящего в интернет.
TASKER_DB_PASSWORD=tasker

# Секрет подписи токенов. Пустой — сервер сгенерирует сам и сохранит в /app/data.
# Задайте явно, если поднимаете несколько реплик за балансировщиком.
TASKER_JWT_SECRET=

# Кто может обращаться к API из браузера. Звёздочка удобна для мобильного клиента,
# но для публичного инстанса лучше перечислить домены через запятую.
TASKER_CORS_ORIGINS=*

# false закрывает регистрацию — новые учётки создать нельзя
TASKER_ALLOW_REGISTRATION=true
